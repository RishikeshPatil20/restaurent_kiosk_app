<div class="admin-layout">
  <%- include("../partials/admin-sidebar", { active: "create-staff" }) %>

  <!-- Main content -->
  <div class="admin-main">
    <nav class="navbar navbar-custom mb-4">
      <span class="navbar-brand mb-0 h1">
        Welcome, <%= user.role %> 👋
      </span>
    </nav>

    <div class="container">
      <h2 class="mb-4">Create New Staff</h2>

      <form action="/api/admin/create-staff" method="POST" class="card p-4 shadow-sm" style="max-width: 500px;">
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>

        <div class="mb-3">
          <label for="email" class="form-label">Email address</label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="Enter staff email"
            value="<%= email %>"
            autocomplete="off"
            required
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="At least 8 characters"
            minlength="8"
            autocomplete="new-password"
            required
          />
        </div>

        <button type="submit" class="btn btn-danger w-100">Create Staff</button>
      </form>
    </div>
  </div>
</div>
