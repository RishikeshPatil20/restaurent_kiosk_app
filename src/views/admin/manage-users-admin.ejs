<div class="admin-layout">
  <%- include("../partials/admin-sidebar", { active: "users" }) %>

  <!-- Main content -->
  <div class="admin-main">
    <nav class="navbar navbar-custom mb-4">
      <span class="navbar-brand mb-0 h1">
        Welcome, <%= user.role %> 👋
      </span>
    </nav>

    <div class="container">
      <h2 class="mb-4">Manage Users</h2>

      <% if (notice) { %>
        <div class="alert alert-<%= notice.type %>" role="alert"><%= notice.text %></div>
      <% } %>

      <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Role</th>
              <th>Created At</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.email %></td>
                <td><%= u.role %></td>
                <td><%= u.createdAt ? new Date(u.createdAt).toLocaleString() : "N/A" %></td>
                <td>
                  <% if (u.id === user.id) { %>
                    <span class="text-muted small">You</span>
                  <% } else { %>
                    <form action="/api/admin/users/<%= u.id %>/delete" method="POST" class="m-0 confirm-delete"
                          data-confirm="Are you sure you want to delete <%= u.email %>?">
                      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin.js"></script>
