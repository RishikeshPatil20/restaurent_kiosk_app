<div class="admin-layout">
  <%- include("../partials/admin-sidebar", { active: "create-staff" }) %>

  <!-- Main content -->
  <div class="admin-main text-center">
    <nav class="navbar navbar-custom mb-4">
      <span class="navbar-brand mb-0 h1">
        Welcome, <%= user.role %> 👋
      </span>
    </nav>

    <div class="container">
      <div class="alert alert-success shadow-sm p-4">
        <h2 class="mb-3">🎉 Staff Created Successfully!</h2>
        <p><strong><%= staff.email %></strong> can now log in as staff.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
          <a href="/api/admin/users" class="btn btn-primary">View All Users</a>
          <a href="/api/admin/create-staff" class="btn btn-outline-success">Add Another</a>
        </div>
      </div>
    </div>
  </div>
</div>
