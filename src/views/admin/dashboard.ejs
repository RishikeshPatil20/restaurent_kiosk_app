<div class="admin-layout">
  <%- include("../partials/admin-sidebar", { active: "dashboard" }) %>

  <!-- Main content -->
  <div class="admin-main">
    <nav class="navbar navbar-custom mb-4">
      <span class="navbar-brand mb-0 h1">
        Welcome, <%= user.role %> 👋
      </span>
    </nav>

    <div class="container-fluid">
      <div class="row g-4">
        <!-- Total Users -->
        <div class="col-sm-6 col-xl-3">
          <div class="card card-dashboard p-3">
            <h5>Total Users</h5>
            <p class="display-6 text-primary"><%= stats.totalUsers %></p>
          </div>
        </div>

        <!-- Staff -->
        <div class="col-sm-6 col-xl-3">
          <div class="card card-dashboard p-3">
            <h5>Staff Members</h5>
            <p class="display-6 text-success"><%= stats.staffCount %></p>
          </div>
        </div>

        <!-- Total Orders -->
        <div class="col-sm-6 col-xl-3">
          <div class="card card-dashboard p-3">
            <h5>Total Orders</h5>
            <p class="display-6 text-secondary"><%= stats.totalOrders %></p>
          </div>
        </div>

        <!-- Orders in the kitchen -->
        <div class="col-sm-6 col-xl-3">
          <div class="card card-dashboard p-3">
            <h5>Orders in Progress</h5>
            <p class="display-6 text-warning"><%= stats.pendingOrders %></p>
          </div>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="row mt-4">
        <div class="col-md-12">
          <div class="card card-dashboard p-3">
            <h5>Recent Activity</h5>
            <% if (stats.recentActivity.length) { %>
              <ul class="list-group list-group-flush">
                <% stats.recentActivity.forEach(activity => { %>
                  <li class="list-group-item"><%= activity %></li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="text-muted m-0">No activity yet.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div> <!-- /Main content -->
</div>
