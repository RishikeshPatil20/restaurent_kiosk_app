<% const currentUser = locals.user; %>
<header class="main-header">
    <a href="/" class="header-brand">
        <img src="/images/Logo-Restaurent-kiosk.png" alt="" class="brand-logo">
        <span class="brand-name">Restaurant Kiosk</span>
    </a>

    <% if (currentUser) { %>
    <nav class="header-actions" aria-label="Main">
        <% if (currentUser.role === "kiosk") { %>
            <a href="/kiosk" class="header-link">Menu</a>
        <% } %>
        <% if (currentUser.role === "staff" || currentUser.role === "admin") { %>
            <a href="/staff" class="header-link">Kitchen</a>
        <% } %>
        <% if (currentUser.role === "admin") { %>
            <a href="/admin" class="header-link">Admin</a>
        <% } %>

        <a href="/api/auth/profile" class="profile-link" title="My profile">
            <img src="/images/profile-image.png" alt="My profile" class="profile-image">
        </a>

        <form action="/api/auth/logout" method="POST" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
        </form>
    </nav>
    <% } %>
</header>
