<div class="container mt-4">
  <h2>👨‍🍳 Kitchen - Live Orders</h2>
  <p class="text-muted">Paid orders appear here automatically. Served and cancelled orders are cleared from the board.</p>

  <p id="no-orders" class="<%= orders.length ? 'd-none' : '' %>">No active orders yet...</p>

  <div id="orders-list" class="row g-3 mt-1">
    <% orders.forEach(order => { %>
      <div class="col-md-6 col-xl-4 kitchen-order" id="order-<%= order.id %>" data-status="<%= order.status %>">
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <h5 class="card-title m-0">Token #<%= order.order_code ?? "—" %></h5>
                <small class="text-muted">Order #<%= order.id %> · <span class="order-time" data-created="<%= order.createdAt.toISOString() %>"></span></small>
              </div>
              <span class="badge text-bg-success">Paid</span>
            </div>

            <div class="d-flex justify-content-between mt-2 small">
              <span><strong>Table:</strong> <%= order.table_number || "N/A" %></span>
              <span><strong>Total:</strong> ₹<%= formatRupees(order.total_amount) %></span>
            </div>

            <!-- Timeline -->
            <%- include("../partials/order-tracker", { order }) %>

            <ul class="kitchen-items">
              <% order.items.forEach(item => { %>
                <li><%= item.menu_snapshot_name %> <strong>x <%= item.quantity %></strong></li>
              <% }) %>
            </ul>

            <div class="order-error alert alert-danger py-1 px-2 small d-none" role="alert"></div>

            <!-- Next-step buttons are rendered by kitchen.js from the order status -->
            <div class="order-actions"></div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/kitchen.js"></script>
