<div class="container py-5 d-flex justify-content-center">
  <div class="payment-box">
    <h2 class="mb-3">💳 Complete Payment</h2>
    <p>Order <strong>#<%= order.id %></strong></p>
    <p class="fs-5"><strong>Total:</strong> ₹<%= formatRupees(order.total_amount) %></p>

    <div id="payment-loading">
      <div class="loader"></div>
      <p class="text-muted">Opening the secure payment window…</p>
    </div>

    <div id="payment-message" class="alert alert-warning d-none" role="alert"></div>

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
      <button type="button" id="pay-button" class="btn btn-danger d-none">Pay Now</button>
      <a href="/kiosk" class="btn btn-outline-dark">⬅ Back to Menu</a>
    </div>

    <!-- ✅ Real Razorpay -->
    <div id="razorpay-container"
         data-key="<%= razorpayKey %>"
         data-orderid="<%= razorpayOrderId %>"
         data-amount="<%= amount %>"
         data-currency="<%= currency %>"
         data-email="<%= email %>"></div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/payment.js"></script>
