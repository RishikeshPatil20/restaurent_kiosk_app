<h4 class="mb-0 text-center py-3">🍴 Restaurant Menu</h4>

<div class="container-fluid" style="margin-top:20px;">
  <div class="row">
    <!-- Categories Sidebar -->
    <div class="col-md-2 border-end sidebar">
      <h5 class="mb-3">📂 Categories</h5>
      <ul id="categories" class="list-group">
        <% const categories=[...new Set(menus.map(m=> m.item_category))]; %>
        <% categories.forEach(cat=> { %>
          <li class="list-group-item p-1 border-0">
            <button class="btn category-btn w-100" data-category="<%= cat %>">
              <%= cat %>
            </button>
          </li>
        <% }) %>
      </ul>
    </div>

    <!-- Main Menu Items -->
    <div class="col-md-7">
      <h5 class="mb-3">🍽️ Menu Items</h5>
      <div id="items-container" class="row">
        <% menus.forEach(item=> { %>
          <div class="col-md-6 mb-3 menu-item" data-category="<%= item.item_category %>">
            <div class="card h-100 shadow-sm p-3 d-flex flex-column">
              <h6><%= item.item_name %></h6>
              <p class="mb-1 text-muted"><%= item.item_description %></p>
              <p class="fw-bold">₹<%= item.item_price %></p>
              <button class="btn btn-sm btn-outline-danger mt-auto add-to-cart"
                      data-id="<%= item.id %>"
                      data-price="<%= item.item_price %>">
                ➕ Add to Cart
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Cart Sidebar -->
    <aside class="col-md-3 border-start cart">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0">🛒 Your Cart</h4>
        <!-- 🚪 Logout Button -->
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
        </form>
      </div>

      <ul id="cart-items" class="list-group mb-3"></ul>
      <div class="d-flex justify-content-between fw-bold mb-3">
        <span>Total:</span>
        <span id="cart-total">₹0</span>
      </div>
      <!-- ✅ Secure: this only posts to /checkout -->
      <form action="/checkout" method="POST">
        <button type="submit" class="btn btn-outline-dark w-100">
          <div class="cart-container d-flex justify-content-between align-items-center">
            <span>Proceed to Checkout</span>
            <span id="cart-count" class="cart-badge">0</span>
          </div>
        </button>
      </form>
    </aside>
  </div>
</div>
