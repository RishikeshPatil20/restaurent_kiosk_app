
<div class="auth-container">
  <div class="card auth-card">
    <h2 class="auth-title">Login</h2>

    <% if (locals.error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <form action="/api/auth/login" method="POST">
      <!-- Email -->
      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Enter your email"
          value="<%= locals.email || '' %>"
          autocomplete="username"
          required
        />
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        />
      </div>

      <!-- Role Selection -->
      <div class="form-group">
        <label for="role">Login as</label>
        <select id="role" name="role" required>
          <option value="">-- Select Role --</option>
          <% [["admin", "Admin"], ["kiosk", "Kiosk User"], ["staff", "Staff"]].forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= locals.role === value ? "selected" : "" %>><%= label %></option>
          <% }) %>
        </select>
      </div>

      <!-- Submit -->
      <button type="submit" class="btn btn-danger w-100 py-2">Login</button>
    </form>

    <p class="hint mt-3 mb-0 text-center">
      Don’t have an account?
      <a href="/register" class="text-danger">Register here</a>
    </p>
  </div>
</div>
