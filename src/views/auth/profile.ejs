<div class="profile-container">
  <!-- Left Column: Profile -->
  <div class="profile-box">
    <h2>👤 Profile</h2>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Role:</strong> <%= user.role %></p>
    <p><strong>Joined:</strong> <%= user.createdAt ? new Date(user.createdAt).toDateString() : "N/A" %></p>

    <div class="back-to-menu">
      <a href="<%= homeUrl %>" class="btn btn-outline-dark">
        ⬅ Back to <%= user.role === "kiosk" ? "Menu" : user.role === "admin" ? "Admin Dashboard" : "Kitchen" %>
      </a>
    </div>
  </div>

  <!-- Right Column: Orders -->
  <div class="orders-box">
    <h2>🧾 My Orders</h2>

    <% if (orders && orders.length > 0) { %>
      <% orders.forEach(order => { %>
        <div class="order-card card mb-3" id="order-<%= order.id %>">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="m-0">
              <% if (order.order_code) { %>Token #<%= order.order_code %> <small class="text-muted fs-6">· Order #<%= order.id %></small>
              <% } else { %>Order #<%= order.id %><% } %>
            </h5>
            <%
              // Paid orders are refunded when staff cancels them
              const [badgeClass, badgeText] =
                order.payment_status === "paid" && order.status === "cancelled" ? ["text-bg-secondary", "Refunded"]
                : order.payment_status === "paid" ? ["text-bg-success", "Paid"]
                : order.payment_status === "failed" ? ["text-bg-danger", "Payment failed"]
                : ["text-bg-warning", "Unpaid"];
            %>
            <span class="badge <%= badgeClass %>" id="payment-<%= order.id %>"><%= badgeText %></span>
          </div>
          <p class="mt-2 mb-1"><strong>Total:</strong> ₹<%= formatRupees(order.total_amount) %></p>
          <p class="mb-1"><strong>Date:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>

          <!-- Timeline -->
          <%- include("../partials/order-tracker", { order }) %>

          <!-- Items -->
          <ul class="mb-0">
            <% order.items.forEach(item => { %>
              <li>
                <%= item.menu_snapshot_name %> x <%= item.quantity %>
                - ₹<%= formatRupees(item.item_price * item.quantity) %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    <% } else { %>
      <p>No orders found.</p>
    <% } %>
  </div>
</div>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script src="/js/profile.js"></script>
