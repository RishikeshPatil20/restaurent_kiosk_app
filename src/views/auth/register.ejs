<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
  <div class="card shadow p-4" style="max-width: 400px; width: 100%;">
    <h3 class="text-center mb-4 text-danger">Register</h3>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/api/auth/register-kiosk" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          placeholder="Enter Kiosk User email"
          required
        />
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Enter Kiosk User password"
          required
        />
      </div>

      <button type="submit" class="btn btn-danger w-100">Register</button>
    </form>

    <p class="mt-3 text-center">
      Already have an account? <a href="/login" class="text-danger">Login here</a>
    </p>
  </div>
</div>
