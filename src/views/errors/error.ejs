<!-- backend/src/views/errors/error.ejs -->
<div class="container text-center my-5">
  <h1 class="display-5 text-danger">
    ⚠️ Error <%= locals.code || 500 %>
  </h1>

  <p class="lead mb-4">
    <%= locals.message || "Something went wrong." %>
  </p>

  <% if (locals.url) { %>
    <p class="text-muted">
      <small>URL: <%= url %></small>
    </p>
  <% } %>

  <% if (locals.stack) { %>
    <details class="text-start bg-light p-3 rounded mb-4">
      <summary>Debug Info (dev only)</summary>
      <pre><%= stack %></pre>
    </details>
  <% } %>

  <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
    <a href="/" class="btn btn-outline-primary">🏠 Home</a>
    <% if (!locals.user) { %>
      <a href="/login" class="btn btn-danger">🔑 Login</a>
    <% } %>
  </div>
</div>
