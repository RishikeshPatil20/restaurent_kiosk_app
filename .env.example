# Copy to .env and fill in real values. Never commit .env.

# App
PORT=5000
NODE_ENV=development
# Long random string used to sign login tokens
SECRET_KEY=change-me-to-a-long-random-string
# Token numbers (#1, #2, ...) restart at midnight in this timezone
BUSINESS_TIMEZONE=Asia/Kolkata
# Comma-separated origins allowed to call the API from another site (leave empty for same-origin only)
CORS_ORIGIN=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DATABASE_NAME=restaurent_kiosk
USER_NAME=postgres
PASSWORD=

# Razorpay (leave empty in development to use simulated payments)
# Test keys: Razorpay Dashboard → Test Mode → Account & Settings → API Keys (key id starts with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret you choose when adding a webhook (Dashboard → Webhooks → URL https://<public-host>/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=
